digraph G {
graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.35, ranksep=0.5, splines=polyline, fontname="Noto Sans CJK SC", fontsize=21, labelloc=t, label="Actor / Critic 详细结构（--roboinfo；B 为当前批量）"];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, margin="0.18,0.12", color="#678099"];
edge [color="#65758B", arrowsize=0.75, fontname="Noto Sans CJK SC", fontsize=11];
obs [label="已归一化观测 [B,1102]\n[特征1024 | 状态63 | 目标抓取6 | 上一动作9]", fillcolor="#e7f1ff"];
feat [label="物体点云特征 [B,1024]", fillcolor="#e7f1ff"];
context [label="共享输入值，网络参数不共享\n状态 [B,63] + 上一动作 [B,9] + 抓取 [B,6]", fillcolor="#e7f1ff"];
obs -> feat [label=""];
obs -> context [label=""];
aenc1 [label="Actor 点云编码\nLinear 1024→512 + ELU\n524,800 参数", fillcolor="#e7f5ec"];
aenc2 [label="Linear 512→128（无末端激活）\n65,664 参数", fillcolor="#e7f5ec"];
acat [label="Concat [状态63, 上一动作9, 编码128, 抓取6]\n[B,206]", fillcolor="#ede8fa"];
ah1 [label="Linear 206→512 + ELU\n105,984 参数", fillcolor="#e7f5ec"];
ah2 [label="Linear 512→256 + ELU\n131,328 参数", fillcolor="#e7f5ec"];
ah3 [label="Linear 256→128 + ELU\n32,896 参数", fillcolor="#e7f5ec"];
aout [label="Linear 128→9\nμ [B,9]；1,161 参数", fillcolor="#fff0d9"];
feat -> aenc1 [label=""];
aenc1 -> aenc2 [label=""];
aenc2 -> acat [label=""];
acat -> ah1 [label=""];
ah1 -> ah2 [label=""];
ah2 -> ah3 [label=""];
ah3 -> aout [label=""];
context -> acat [label=""];
venc1 [label="Critic 点云编码\nLinear 1024→512 + ELU\n524,800 参数", fillcolor="#e7f5ec"];
venc2 [label="Linear 512→128（无末端激活）\n65,664 参数", fillcolor="#e7f5ec"];
vcat [label="Concat [状态63, 上一动作9, 编码128, 抓取6]\n[B,206]", fillcolor="#ede8fa"];
vh1 [label="Linear 206→512 + ELU\n105,984 参数", fillcolor="#e7f5ec"];
vh2 [label="Linear 512→256 + ELU\n131,328 参数", fillcolor="#e7f5ec"];
vh3 [label="Linear 256→128 + ELU\n32,896 参数", fillcolor="#e7f5ec"];
vout [label="Linear 128→1\nV(s) [B,1]；129 参数", fillcolor="#fff0d9"];
feat -> venc1 [label=""];
venc1 -> venc2 [label=""];
venc2 -> vcat [label=""];
vcat -> vh1 [label=""];
vh1 -> vh2 [label=""];
vh2 -> vh3 [label=""];
vh3 -> vout [label=""];
context -> vcat [label=""];
std [label="Actor 独立 log_std [9]\n9 个可学习参数；截断 [-20,2]", fillcolor="#e7f5ec"];
gauss [label="π(a|o) = Normal(μ, diag(exp(log_std)²))\n采样 a [B,9] / log_prob [B,1]\n评估使用确定性动作；可沿用 --use_tanh", fillcolor="#fff0d9"];
value [label="价值损失输入 / GAE 自举\n沿用原 Value 的未使用 log_std [9]\n不参与 Critic 前向与梯度", fillcolor="#eef0f4"];
aout -> gauss [label=""];
std -> gauss [label=""];
vout -> value [label=""];
}
