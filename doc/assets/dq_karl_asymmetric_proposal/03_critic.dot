digraph proposal {
graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.35", nodesep="0.45", ranksep="0.65", splines=polyline, fontname="Noto Sans CJK SC", fontsize=23, fontcolor="#1E293B", labelloc=t, label="03｜仅训练 Critic：感知历史 + 特权物理摘要\n建议方案｜尚未实现 / 训练验证"];
node [shape=box, style="rounded,filled", margin="0.06,0.04", penwidth=1.5, fontname="Noto Sans CJK SC", fontsize=15, fontcolor="#172B42"];
edge [fontname="Noto Sans CJK SC", fontsize=12, color="#65758B", fontcolor="#52647B", penwidth=1.5, arrowsize=0.75];
aobs [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>同一条可部署观测 oₜᴬ</B></TD></TR><TR><TD ALIGN="LEFT">机器人状态 76 + 目标历史 192</TD></TR><TR><TD ALIGN="LEFT">[B,268]；含实际估计误差 / 丢失历史</TD></TR><TR><TD ALIGN="LEFT">Critic 使用自己独立的归一化和编码器</TD></TR></TABLE>>, fillcolor="#F0F3F7", color="#6C7B91"];
privobs [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>新增特权状态 sₜᵖ : [B,80]</B></TD></TR><TR><TD ALIGN="LEFT">物体真实位姿 9 + 真实 twist 6 = 15</TD></TR><TR><TD ALIGN="LEFT">同一 Actor 候选 ID：真位姿 9 + 关键点误差 12 = 21</TD></TR><TR><TD ALIGN="LEFT">真实底盘 twist 6 + 真实 EE twist 6</TD></TR><TR><TD ALIGN="LEFT">接触概要 4（新增计算；非直接对象配对力）</TD></TR><TR><TD ALIGN="LEFT">物体尺寸 3 + 质量 1 + 摩擦 1 = 5</TD></TR><TR><TD ALIGN="LEFT">桌面位姿 9 + twist 6 = 15</TD></TR><TR><TD ALIGN="LEFT">原任务状态 5 + 新阶段 one-hot 3 = 8</TD></TR></TABLE>>, fillcolor="#FCE8E5", color="#BB625A"];
{ rank=same; aobs; privobs; }
aenc [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>Critic 可部署观测编码器</B></TD></TR><TR><TD ALIGN="LEFT">Linear 268 → 128 + ELU</TD></TR><TR><TD ALIGN="LEFT">Linear 128 → 128 + ELU</TD></TR><TR><TD ALIGN="LEFT">输出 [B,128]</TD></TR></TABLE>>, fillcolor="#F0E7FF", color="#8B63B8"];
privenc [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>Critic 特权编码器</B></TD></TR><TR><TD ALIGN="LEFT">独立按字段归一化</TD></TR><TR><TD ALIGN="LEFT">Linear 80 → 256 + ELU</TD></TR><TR><TD ALIGN="LEFT">Linear 256 → 128 + ELU</TD></TR><TR><TD ALIGN="LEFT">输出 [B,128]</TD></TR></TABLE>>, fillcolor="#F0E7FF", color="#8B63B8"];
aobs -> aenc;
privobs -> privenc;
{ rank=same; aenc; privenc; }
cat [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>拼接 [B,128] ⊕ [B,128]</B></TD></TR><TR><TD ALIGN="LEFT">融合输入 [B,256]</TD></TR></TABLE>>, fillcolor="#F0F3F7", color="#6C7B91"];
aenc -> cat;
privenc -> cat;
vnet [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>价值 MLP</B></TD></TR><TR><TD ALIGN="LEFT">Linear 256 → 256 + ELU</TD></TR><TR><TD ALIGN="LEFT">Linear 256 → 128 + ELU</TD></TR><TR><TD ALIGN="LEFT">Linear 128 → 1</TD></TR></TABLE>>, fillcolor="#F0E7FF", color="#8B63B8"];
cat -> vnet;
v [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>状态价值 Vφ(oₜᴬ, sₜᵖ) : [B,1]</B></TD></TR><TR><TD ALIGN="LEFT">用于 GAE / 回报估计 / 价值损失</TD></TR><TR><TD ALIGN="LEFT">Critic 通过 GAE 优势提供策略训练信号</TD></TR></TABLE>>, fillcolor="#F0E7FF", color="#8B63B8"];
vnet -> v;
guard [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>独立参数与同一任务目标</B></TD></TR><TR><TD ALIGN="LEFT">原始 Critic 输入：268 + 80 = 348</TD></TR><TR><TD ALIGN="LEFT">全部参数独立于 Actor；无特权特征回流</TD></TR><TR><TD ALIGN="LEFT">不得给 Critic / 奖励另选一个候选 ID</TD></TR><TR><TD ALIGN="LEFT">203,393 个可训练参数；训练后不部署</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
v -> guard [style="invis"];
legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10"><TR><TD BGCOLOR="#E5EEFF">蓝：训练 / 部署 Actor</TD><TD BGCOLOR="#F0E7FF">紫：仅训练 Critic</TD><TD BGCOLOR="#E1F4EE">绿：固定感知 / 控制</TD></TR><TR><TD BGCOLOR="#FCE8E5">红：仿真真值</TD><TD BGCOLOR="#F0F3F7">灰：观测 / 计算</TD><TD BGCOLOR="#FFF4D9">黄：设计约束</TD></TR></TABLE>>];
{ rank=sink; legend; }
}