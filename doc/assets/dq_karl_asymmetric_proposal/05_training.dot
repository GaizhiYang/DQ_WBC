digraph proposal {
graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.35", nodesep="0.45", ranksep="0.65", splines=polyline, fontname="Noto Sans CJK SC", fontsize=23, fontcolor="#1E293B", labelloc=t, label="05｜单阶段高层 PPO：独立 Actor / Critic 与持续课程\n建议方案｜尚未实现 / 训练验证"];
node [shape=box, style="rounded,filled", margin="0.06,0.04", penwidth=1.5, fontname="Noto Sans CJK SC", fontsize=15, fontcolor="#172B42"];
edge [fontname="Noto Sans CJK SC", fontsize=12, color="#65758B", fontcolor="#52647B", penwidth=1.5, arrowsize=0.75];
start [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>一套高层 Actor + 一套独立 Critic</B></TD></TR><TR><TD ALIGN="LEFT">Actor 从第一步起仅使用部署可获得的信息</TD></TR><TR><TD ALIGN="LEFT">感知模块与底层全身控制保持冻结</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
collect [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>并行采样 rollout</B></TD></TR><TR><TD ALIGN="LEFT">同一滤波器 / 候选选择器构建 oᴬ [268]</TD></TR><TR><TD ALIGN="LEFT">Actor 采样 9 维高层动作 → DQ 执行接口</TD></TR><TR><TD ALIGN="LEFT">记录动作、old log_prob、oᴬ、sᵖ、奖励、终止</TD></TR></TABLE>>, fillcolor="#E5EEFF", color="#416DC2"];
start -> collect;
reward [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>真实物理状态构造训练奖励</B></TD></TR><TR><TD ALIGN="LEFT">同一候选 ID 的抓取关键点对齐</TD></TR><TR><TD ALIGN="LEFT">提升 / 保持、机器人稳定、碰撞与动作平滑</TD></TR><TR><TD ALIGN="LEFT">双相机可见性与恢复，不把短遮挡等同失败</TD></TR></TABLE>>, fillcolor="#FCE8E5", color="#BB625A"];
{ rank=same; collect; reward; }
reward -> collect [constraint="false", label="rₜ / done"];
gae [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>Critic 估值 → GAE / return</B></TD></TR><TR><TD ALIGN="LEFT">正确处理超时 bootstrap 与真实终止</TD></TR><TR><TD ALIGN="LEFT">固定采样期 log_prob 和实际传入的观测</TD></TR></TABLE>>, fillcolor="#F0E7FF", color="#8B63B8"];
collect -> gae;
update [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>同一轮 PPO 更新</B></TD></TR><TR><TD ALIGN="LEFT">Actor：clip 策略损失 + 熵项</TD></TR><TR><TD ALIGN="LEFT">Critic：价值回归损失</TD></TR><TR><TD ALIGN="LEFT">Actor / Critic 参数、归一化统计相互独立</TD></TR><TR><TD ALIGN="LEFT">无教师动作标签、无 BC、无 α 混合</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
gae -> update;
update -> collect [constraint="false", color="#416DC2", label="重复采样 / 更新"];
subgraph cluster_curriculum { label="同一个策略的任务难度课程（不是四个训练网络）"; color="#D3B267"; style="rounded,dashed";
c0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>难度 0：建立抓取能力</B></TD></TR><TR><TD ALIGN="LEFT">静态 / 较近目标；基础测量噪声</TD></TR><TR><TD ALIGN="LEFT">Actor 观测边界从开始就保持一致</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
c1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>难度 1：全身接近</B></TD></TR><TR><TD ALIGN="LEFT">扩大起点 / 物体 / 桌面变化</TD></TR><TR><TD ALIGN="LEFT">强化移动到底盘可操作区域</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
c2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>难度 2：动态目标</B></TD></TR><TR><TD ALIGN="LEFT">从低速增至更快轨迹 / 角速度，模型 / 标定偏差</TD></TR><TR><TD ALIGN="LEFT">检查运动估计与执行饱和</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
c3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>难度 3：感知中断</B></TD></TR><TR><TD ALIGN="LEFT">经标定异步延迟、短失视、异常重获与失败重试</TD></TR><TR><TD ALIGN="LEFT">保留简单任务采样</TD></TR></TABLE>>, fillcolor="#FFF4D9", color="#BA9137"];
c0 -> c1;
c1 -> c2;
c2 -> c3;
}
update -> c0 [style="dashed", label="分阶段独立验证窗口"];
export [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><B>完成训练 → 导出同一个 Actor</B></TD></TR><TR><TD ALIGN="LEFT">Actor 参数 / 归一化 + 固定状态构造配置</TD></TR><TR><TD ALIGN="LEFT">真机运行感知 → Actor → 现有全身控制</TD></TR><TR><TD ALIGN="LEFT">先验证真实感知闭环，再报告抓取成功率</TD></TR></TABLE>>, fillcolor="#E5EEFF", color="#416DC2"];
c3 -> export;
legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10"><TR><TD BGCOLOR="#E5EEFF">蓝：训练 / 部署 Actor</TD><TD BGCOLOR="#F0E7FF">紫：仅训练 Critic</TD><TD BGCOLOR="#E1F4EE">绿：固定感知 / 控制</TD></TR><TR><TD BGCOLOR="#FCE8E5">红：仿真真值</TD><TD BGCOLOR="#F0F3F7">灰：观测 / 计算</TD><TD BGCOLOR="#FFF4D9">黄：设计约束</TD></TR></TABLE>>];
{ rank=sink; legend; }
}