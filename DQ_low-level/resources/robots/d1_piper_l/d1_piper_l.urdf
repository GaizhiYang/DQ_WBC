<?xml version="1.0" ?>
<!-- Combined D1 + Piper-L URDF assembled from d1_description/urdf/robot.urdf and piper_l/urdf/piper_l_description.urdf. -->
<robot name="d1_piper_l">
  <mujoco>
      <compiler fusestatic="false" meshdir="." discardvisual="false"/>
  </mujoco>
  <!-- Robot Base link -->
  <link name="base_link">
    <visual name="base_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
  <!-- Imu link -->
  <link name="imu_link">
    <visual name="imu_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
  <!-- Imu Joint -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Base link -->
  <link name="F_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.030736 0.00016011 -0.033144"/>
      <mass value="9.158"/>
      <inertia ixx="0.073416" ixy="0.00014675" ixz="-0.0079314" iyy="0.12672" iyz="1.9414E-05" izz="0.11933"/>
    </inertial>
    <visual name="F_base_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="d1_description/meshes/base_link.STL"/>
      </geometry>
      <material>
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision name="F_base_link_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.275 0.15 0.18"/>
      </geometry>
    </collision>
    <collision name="F_base_link_collision_1">
      <origin rpy="0 0 0" xyz="0 0 -0.1"/>
      <geometry>
        <box size="0.35 0.15 0.1"/>
      </geometry>
    </collision>
  </link>
  <!-- Base link joint -->
  <!-- Keep this named body because the low-level task uses F_base_link for
       base-mass randomization and diagnostics when fixed joints are collapsed. -->
  <joint name="F_base_joint" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0.1875 0 0"/>
    <parent link="base_link"/>
    <child link="F_base_link"/>
  </joint>
  <!-- Face link -->
  <link name="F_face_link">
